<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.15</version>
    <relativePath/>
  </parent>

  <groupId>com.telesentinel</groupId>
  <artifactId>telesentinel-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>TeleSentinel Platform</name>

  <properties>
    <java.version>21</java.version>
    <spring-ai.version>1.1.8</spring-ai.version>
    <spring-cloud.version>2025.1.3</spring-cloud.version>
  </properties>

  <modules>
    <module>services/ts-ingestion</module>
    <module>services/ts-fraud</module>
    <module>services/ts-correlation</module>
    <module>services/ts-rag-assistant</module>
    <module>services/ts-gateway</module>
    <module>services/ts-notification</module>
    <!-- Next steps: ts-fraud, ts-correlation, ts-rag-assistant, ts-gateway, ts-notification -->
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
